{
  "name": "@nexoraaidrishti/ssr",
  "version": "0.2.0",
  "description": "DRISHTI server-side rendering — renderToString + client hydration",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexoraaidrishti/runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2ool4techai-oss/front"
  },
  "keywords": ["ssr", "server-side-rendering", "streaming", "hydration", "framework", "typescript", "drishti"],
  "files": ["dist", "src", "README.md"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
