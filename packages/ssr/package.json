{
  "name": "@drishti/ssr",
  "version": "0.1.0",
  "description": "DRISHTI server-side rendering — renderToString + client hydration",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
