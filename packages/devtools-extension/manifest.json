{
  "manifest_version": 3,
  "name": "DRISHTI DevTools",
  "version": "0.1.0",
  "description": "Signal state inspector for DRISHTI framework",
  "permissions": ["storage", "tabs"],
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  }
}
